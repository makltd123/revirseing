{
  "name": "revirseing",
  "version": "0.1.0",
  "description": "A from-scratch PDF toolkit: inspect the structure of a PDF and extract its text, built directly against the ISO 32000 (PDF) file format.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "revirseing": "bin/revirseing.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:browser": "esbuild browser/entry.js --bundle --format=iife --global-name=REA --alias:node:zlib=./browser/shim-zlib.js --alias:node:crypto=./browser/shim-crypto.js --inject:browser/buffer-inject.js --outfile=browser/rea.bundle.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "browser"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pako": "^3.0.2",
    "buffer": "^6.0.3"
  }
}
